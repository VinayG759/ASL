{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asl.local/schemas/govern-request.json",
  "title": "GovernRequest",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "arguments",
    "agent_id",
    "session_id",
    "timestamp",
    "principal"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "arguments": {
      "type": "object"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "principal": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "service", "anonymous"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delegation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id"],
        "additionalProperties": false,
        "properties": {
          "agent_id": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "tool": "update_ticket",
      "arguments": { "ticket_id": "T-123", "status": "resolved" },
      "agent_id": "nexusflow/support-agent",
      "session_id": "sess_abc123",
      "timestamp": "2026-06-28T10:00:00Z",
      "principal": { "type": "user", "id": "user:U42" },
      "delegation_chain": [
        { "agent_id": "orchestrator", "role": "orchestrator" },
        { "agent_id": "support-agent", "role": "executor" }
      ],
      "metadata": { "runtime": "nexusflow" }
    }
  ]
}
