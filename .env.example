# ASL API — copy to .env and adjust for local development

# PostgreSQL (docker-compose service name: postgres)
DATABASE_URL=postgresql+asyncpg://asl:asl_dev_password@postgres:5432/asl
DATABASE_URL_SYNC=postgresql+psycopg://asl:asl_dev_password@postgres:5432/asl

# Single v0 API key (Bearer token). Generate a random string for local use.
ASL_API_KEY=asl_dev_change_me_in_production

# Application
ASL_ENV=development
ASL_LOG_LEVEL=INFO

# Postgres container (used by docker-compose)
POSTGRES_USER=asl
POSTGRES_PASSWORD=asl_dev_password
POSTGRES_DB=asl
